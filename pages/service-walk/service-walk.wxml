<view class="page">
  <!-- 预算信息 -->
  <view class="card budget-card">
    <view class="row">
      <text class="label">每次预算</text>
      <text class="value price">¥{{budget}}</text>
    </view>
    <view class="row">
      <text class="label">单次服务</text>
      <view class="times-value">
        <text class="times">共{{times}}次</text>
        <text class="amount">¥{{totalAmount}}</text>
      </view>
    </view>
  </view>

  <!-- 需求标签 -->
  <view class="card">
    <view class="card-title">需求标签</view>
    <view class="tag-wrap">
      <view
        wx:for="{{tags}}"
        wx:key="id"
        class="tag {{item.selected ? 'tag-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="toggleTag"
      >{{item.name}}</view>
    </view>

    <view class="custom-tag-wrap">
      <input
        class="custom-input"
        placeholder="自定义标签"
        value="{{customTag}}"
        bindinput="onCustomTagInput"
        confirm-type="done"
        bindconfirm="addCustomTag"
      />
      <view class="add-btn" bindtap="addCustomTag">+</view>
    </view>

    <view class="tag-wrap" wx:if="{{customTags.length}}">
      <view
        wx:for="{{customTags}}"
        wx:key="*this"
        class="tag tag-active tag-custom"
        data-index="{{index}}"
        bindtap="removeCustomTag"
      >{{item}} ×</view>
    </view>
  </view>

  <!-- 联系信息 -->
  <view class="card">
    <view class="card-title">联系信息</view>
    <view class="contact-row" bindtap="selectDog">
      <text class="contact-label">选择狗狗</text>
      <view class="contact-right">
        <text class="contact-value {{selectedDog ? 'active' : ''}}">{{selectedDog || '请选择'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="contact-row" wx:if="{{contactName}}">
      <text class="contact-label">联系人</text>
      <text class="contact-value">{{contactName}}</text>
    </view>
    <view class="contact-row" wx:if="{{contactPhone}}">
      <text class="contact-label">联系电话</text>
      <text class="contact-value">{{contactPhone}}</text>
    </view>
  </view>

  <!-- 微信号 -->
  <view class="card">
    <view class="field-row">
      <text class="field-label">微信号</text>
      <input
        class="field-input"
        placeholder="请输入微信号"
        value="{{wechatId}}"
        bindinput="onWechatInput"
      />
    </view>
  </view>

  <!-- 手机号 -->
  <view class="card">
    <view class="field-row">
      <text class="field-label">手机号</text>
      <input
        class="field-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
  </view>

  <!-- 补充说明 -->
  <view class="card">
    <view class="field-row align-top">
      <view class="field-label-wrap">
        <text class="field-label">补充说明</text>
        <text class="optional">可选</text>
      </view>
      <textarea
        class="field-textarea"
        placeholder="请输入补充说明"
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="200"
      />
    </view>
  </view>

  <!-- 占位，避免底部按钮遮挡 -->
  <view class="bottom-placeholder"></view>

  <!-- 提交按钮 -->
  <view class="footer">
    <button class="submit-btn" bindtap="submit">提交需求</button>
  </view>
</view>
/* 全局变量：主色 深墨绿 #2D6A4F；辅助蓝 #3B6CFF；背景 #F5F5F5 */

page {
  background: #F5F5F5;
}

.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 20rpx;
}

/* 预算卡片 */
.budget-card {
  background: #FFFFFF;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.row + .row {
  border-top: 2rpx solid #F5F5F5;
}

.label {
  font-size: 28rpx;
  color: #666666;
}

.value {
  font-size: 28rpx;
  color: #2D6A4F;
  font-weight: 600;
}

.price {
  font-size: 32rpx;
  font-weight: 700;
}

.times-value {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.times {
  font-size: 26rpx;
  color: #999999;
  background: #F5F5F5;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.amount {
  font-size: 30rpx;
  color: #2D6A4F;
  font-weight: 700;
}

/* 卡片标题 */
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D6A4F;
  margin-bottom: 24rpx;
}

/* 标签 */
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666666;
  background: #F5F5F5;
  border: 2rpx solid #EEEEEE;
  line-height: 1.4;
}

.tag-active {
  color: #FFFFFF;
  background: #2D6A4F;
  border-color: #2D6A4F;
}

.tag-custom {
  background: #3B6CFF;
  border-color: #3B6CFF;
}

/* 自定义标签输入 */
.custom-tag-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.custom-input {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #333333;
  background: #F5F5F5;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.add-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 50%;
  background: #2D6A4F;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
}

/* 联系信息 */
.contact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.contact-row:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 28rpx;
  color: #333333;
}

.contact-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #999999;
}

.contact-value.active {
  color: #2D6A4F;
  font-weight: 600;
}

.arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* 字段行 */
.field-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.field-row.align-top {
  align-items: flex-start;
}

.field-label-wrap {
  width: 160rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.field-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}

.optional {
  font-size: 22rpx;
  color: #999999;
  font-weight: 400;
}

.field-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  color: #333333;
}

.field-textarea {
  flex: 1;
  min-height: 140rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #333333;
  background: #F5F5F5;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* 底部按钮 */
.bottom-placeholder {
  height: 160rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  z-index: 10;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: #3B6CFF;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.submit-btn::after {
  border: none;
}
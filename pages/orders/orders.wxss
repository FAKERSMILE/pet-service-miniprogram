.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

/* === 状态筛选 === */
.tabs {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}
.tab {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #F5F5F5;
  color: #6B6B6B;
  font-size: 26rpx;
  font-weight: 600;
  transition: all .2s;
}
.tab.is-sel {
  background: #2D6A4F;
  color: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(45,106,79,0.25);
}

/* === 空态 === */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-emoji { font-size: 88rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 26rpx; color: #9A9A9A; }

/* === 订单卡 === */
.order-list { margin: 24rpx 32rpx; }
.order-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #F0F0F0;
  margin-bottom: 18rpx;
}
.order-no {
  font-size: 22rpx;
  color: #9A9A9A;
}
.order-status {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.st-pending {
  background: rgba(59,108,255,0.12);
  color: #3B6CFF;
}
.st-done {
  background: rgba(45,106,79,0.12);
  color: #2D6A4F;
}
.st-cancelled {
  background: rgba(0,0,0,0.06);
  color: #9A9A9A;
}

.order-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.order-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.order-emoji { font-size: 48rpx; }

.order-info { flex: 1; min-width: 0; }
.order-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}
.order-time {
  font-size: 22rpx;
  color: #6B6B6B;
  margin-bottom: 4rpx;
}
.order-server {
  font-size: 22rpx;
  color: #9A9A9A;
}
.order-price { flex-shrink: 0; }
.price-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D6A4F;
}

/* === 操作按钮 === */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}
.btn {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}
.btn.ghost {
  color: #6B6B6B;
  background: #F5F5F5;
}
.btn.primary {
  color: #FFFFFF;
  background: #2D6A4F;
}

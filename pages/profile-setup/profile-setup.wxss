page { background: #F5F5F5; }

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 40rpx 32rpx calc(env(safe-area-inset-bottom) + 180rpx);
  box-sizing: border-box;
}

/* 默认头像 */
.avatar-wrap {
  display: flex;
  justify-content: center;
  padding: 60rpx 0 70rpx;
}
.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #3B6CFF;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-text {
  color: #FFFFFF;
  font-size: 80rpx;
  font-weight: 600;
}
.avatar-img {
  width: 100%;
  height: 100%;
}

/* 通用行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}
.row.column {
  flex-direction: column;
  align-items: stretch;
}
.row-label {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
}
.row.column .row-label {
  margin-bottom: 24rpx;
}
.row-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.row-text {
  font-size: 28rpx;
  color: #1A1A1A;
}
.row-link {
  font-size: 26rpx;
  color: #3B6CFF;
}
.row-arrow {
  color: #C7C7C7;
  font-size: 28rpx;
  margin-left: 8rpx;
}
.nick-input {
  text-align: right;
  font-size: 28rpx;
  color: #1A1A1A;
  width: 320rpx;
}

/* 人宠合照上传区 */
.photo-box {
  width: 100%;
  height: 280rpx;
  border: 2rpx dashed #C7C7C7;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAFAFA;
  overflow: hidden;
}
.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.photo-plus {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #3B6CFF;
  color: #FFFFFF;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 80rpx;
}
.photo-tip {
  font-size: 24rpx;
  color: #9A9A9A;
}
.photo-img {
  width: 100%;
  height: 100%;
}

/* 位置文字链接 */
.location-link {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #3B6CFF;
  padding: 32rpx 0;
}

/* 底部完成按钮 */
.btn-complete {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  height: 96rpx;
  background: #3B6CFF;
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
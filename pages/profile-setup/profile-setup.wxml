<view class="container">
  <!-- 默认头像 -->
  <view class="avatar-wrap" bindtap="onChooseAvatar">
    <view class="avatar" style="background: {{avatarUrl ? '' : avatarColor}};">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <text wx:else class="avatar-text">{{avatarText}}</text>
    </view>
  </view>

  <!-- 微信昵称 -->
  <view class="row">
    <view class="row-label">微信昵称</view>
    <view class="row-value">
      <input class="nick-input" type="nickname" value="{{nickName}}" bindinput="onChooseNickName" placeholder="请输入昵称" />
      <text class="row-arrow">＞</text>
    </view>
  </view>

  <!-- 人宠合照 -->
  <view class="row column">
    <view class="row-label">人宠合照</view>
    <view class="photo-box" bindtap="onChoosePhoto">
      <image wx:if="{{photo}}" class="photo-img" src="{{photo}}" mode="aspectFill" />
      <view wx:else class="photo-placeholder">
        <view class="photo-plus">+</view>
        <view class="photo-tip">上传合照</view>
      </view>
    </view>
  </view>

  <!-- 常用城市 -->
  <view class="row" bindtap="onChooseCity">
    <view class="row-label">常用城市</view>
    <view class="row-value">
      <text class="row-text">{{city}}</text>
      <text class="row-link">切换</text>
    </view>
  </view>

  <!-- 选择常用位置 -->
  <view class="location-link" bindtap="onChooseLocation">选择常用位置</view>

  <!-- 完成按钮 -->
  <view class="btn-complete" bindtap="onComplete">完成并进入狗狗大队</view>
</view>
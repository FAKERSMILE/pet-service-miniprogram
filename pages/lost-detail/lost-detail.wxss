page {
  background: #F5F5F5;
}

.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 160rpx;
}

.swiper {
  width: 100%;
  height: 520rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.card {
  background: #ffffff;
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.badge-row {
  margin-bottom: 24rpx;
}

.badge {
  display: inline-block;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.badge-blue {
  background: #3B6CFF;
  color: #ffffff;
}

.description {
  font-size: 32rpx;
  color: #1a1a1a;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.meta-row {
  font-size: 26rpx;
  color: #888888;
  margin-bottom: 20rpx;
}

.tag-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tag {
  font-size: 22rpx;
  color: #2D6A4F;
  border: 1rpx solid #2D6A4F;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  background: rgba(45, 106, 79, 0.06);
}

.section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 26rpx;
  color: #2D6A4F;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.section-content {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #ffffff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eeeeee;
  gap: 16rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 44rpx;
  font-size: 28rpx;
  line-height: 1;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #3B6CFF;
  color: #ffffff;
}

.btn-outline {
  background: #ffffff;
  color: #3B6CFF;
  border: 1rpx solid #3B6CFF;
}

.btn-hover {
  opacity: 0.8;
}
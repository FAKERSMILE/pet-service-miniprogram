.container { padding-bottom: calc(env(safe-area-inset-bottom) + 140rpx); }

/* 顶部 */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx 12rpx;
}
.topbar-left { display: flex; align-items: center; }
.topbar-title { font-size: 38rpx; font-weight: 700; color: #1A1A1A; }
.caret {
  width: 0; height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #2D6A4F;
  margin-left: 12rpx;
}
.topbar-right { display: flex; align-items: center; }
.city-badge {
  padding: 6rpx 18rpx;
  background: rgba(45,106,79,0.12);
  color: #2D6A4F;
  border-radius: 999rpx;
  font-size: 22rpx;
}

/* 搜索栏 */
.search {
  margin: 8rpx 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 18rpx 26rpx;
  display: flex; align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-ph { color: #9A9A9A; font-size: 26rpx; }

/* 狗狗出租 */
.rent-card { padding: 28rpx; }
.rent-head { margin-bottom: 20rpx; }
.rent-title { font-size: 32rpx; font-weight: 700; color: #1A1A1A; }
.rent-sub { color: #9A9A9A; font-size: 24rpx; margin-top: 4rpx; }
.rent-grid { display: flex; gap: 20rpx; }
.rent-item {
  flex: 1; position: relative;
  border-radius: 18rpx;
  padding: 26rpx 22rpx 90rpx;
  overflow: hidden;
  color: #FFFFFF;
  min-height: 180rpx;
}
.rent-emoji { font-size: 48rpx; }
.rent-info { margin-top: 14rpx; }
.rent-name { font-size: 28rpx; font-weight: 700; }
.rent-desc { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }
.rent-price { font-size: 22rpx; opacity: 0.9; margin-top: 6rpx; }
.rent-btn {
  position: absolute; right: 16rpx; bottom: 16rpx;
  background: #2D6A4F;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* 功能入口 */
.quick-card { padding: 24rpx; }
.quick-row { display: flex; justify-content: space-around; }
.quick-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.quick-circle {
  width: 96rpx; height: 96rpx;
  background: rgba(45,106,79,0.10);
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx;
}
.quick-title { font-size: 26rpx; color: #1A1A1A; margin-top: 12rpx; font-weight: 600; }
.quick-desc { font-size: 20rpx; color: #9A9A9A; margin-top: 4rpx; }
.quick-more { margin-top: 18rpx; text-align: right; color: #2D6A4F; font-size: 22rpx; }
.arrow { margin-left: 6rpx; }

/* 狗狗广场 */
.square-card { padding: 24rpx; }
.square-head { display: flex; justify-content: space-between; align-items: center; }
.square-titlewrap { display: flex; align-items: baseline; gap: 12rpx; }
.square-title { font-size: 32rpx; font-weight: 700; color: #1A1A1A; }
.square-sub { color: #9A9A9A; font-size: 22rpx; }
.square-search-btn {
  width: 56rpx; height: 56rpx;
  background: #1A1A1A;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.search-dot { color: #FFFFFF; font-size: 18rpx; }

.square-tabs { white-space: nowrap; margin: 18rpx -8rpx 6rpx; }
.square-tab {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin: 0 8rpx;
  background: #F0F0F0;
  color: #6B6B6B;
  border-radius: 999rpx;
  font-size: 24rpx;
}
.square-tab.is-sel { background: #2D6A4F; color: #FFFFFF; }

.square-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 20rpx;
}
.dog-card {
  width: calc((100% - 48rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dog-avatar {
  width: 156rpx; height: 156rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 12rpx;
}
.dog-emoji { font-size: 64rpx; }
.dog-avatar-more { background: #EFEFEF; color: #2D6A4F; }
.dog-name { font-size: 26rpx; color: #1A1A1A; font-weight: 600; }
.dog-breed { font-size: 20rpx; color: #9A9A9A; margin-top: 2rpx; }

/* 记录狗狗的一生 */
.record-card {
  display: flex; align-items: center;
  background: linear-gradient(135deg, #2D6A4F 0%, #52B788 100%);
  color: #FFFFFF;
  padding: 28rpx;
}
.record-emoji { font-size: 56rpx; margin-right: 20rpx; }
.record-content { flex: 1; }
.record-title { font-size: 30rpx; font-weight: 700; }
.record-desc { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }
.record-btn {
  background: #FFFFFF;
  color: #2D6A4F;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}